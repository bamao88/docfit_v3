.DS_Store
.venv/
.pytest_cache/
__pycache__/
*.py[cod]
test_outputs/*
!test_outputs/.gitkeep
!test_outputs/README.md
!test_outputs/debug/
!test_outputs/debug/.gitkeep
!test_outputs/workbench/
!test_outputs/workbench/.gitkeep
test_outputs/debug/*
!test_outputs/debug/.gitkeep
!test_outputs/debug/*/
test_outputs/debug/*/*
!test_outputs/debug/*/.gitkeep
test_outputs/workbench/*
!test_outputs/workbench/.gitkeep
