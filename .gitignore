.DS_Store
.venv/
.pytest_cache/
__pycache__/
*.py[cod]
test_outputs/*
!test_outputs/.gitkeep
!test_outputs/README.md
!test_outputs/debug/
!test_outputs/debug/.gitkeep
!test_outputs/workbench/
!test_outputs/workbench/.gitkeep
test_outputs/debug/*
!test_outputs/debug/.gitkeep
!test_outputs/debug/*/
test_outputs/debug/*/*
!test_outputs/debug/*/.gitkeep
test_outputs/workbench/*
!test_outputs/workbench/.gitkeep

runs/*
!runs/.gitkeep
!runs/README.md
!runs/eval/
!runs/template_generation/
!runs/convert/
!runs/workbench/
runs/eval/*
!runs/eval/.gitkeep
runs/template_generation/*
!runs/template_generation/.gitkeep
runs/convert/*
!runs/convert/.gitkeep
runs/workbench/*
!runs/workbench/.gitkeep
