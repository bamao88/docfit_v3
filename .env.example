# 复制为 .env 后填入真实值（.env 已在 .gitignore，不会提交）。
# scripts/observe_live.py 启动时自动加载项目根目录的 .env；已在 shell 里 export 的同名变量优先。

# Kimi / Moonshot（Module 1 live observation，文本）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

# MiniMax（有视觉能力，用于 T4 读页图）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-M3
