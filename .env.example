# 本地运行会自动读取项目根目录 .env；shell 显式导出的变量优先。真实密钥不得提交。

# Kimi / Moonshot（Module 1 live observation，文本）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

# MiniMax（有视觉能力，用于 T4 读页图）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# 可选：统一 provider 编排。
# 文本(T2/T3): MiniMax -> 额度耗尽时 Kimi -> UNKNOWN。
# 视觉(T4): MiniMax -> UNKNOWN；Kimi 文本端点不能接管视觉输入。
DOCFIT_TEMPLATE_AGENT_TEXT_PROVIDER=minimax
DOCFIT_TEMPLATE_AGENT_VISION_PROVIDER=minimax
